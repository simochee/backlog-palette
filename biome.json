{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/.wxt", "!**/.output", "!**/storybook-static"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "packages/core は React を知らない。表示に関わる判断は packages/ui へ。",
                  "react-dom": "packages/core は React を知らない。",
                  "wxt/browser": "packages/core はブラウザ拡張 API を知らない。呼び出しは apps/extension へ。",
                  "@backlog-palette/ui": "依存の向きが逆。core は ui を知らない（docs/implementation-plan.md §6.2）。"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@backlog-palette/core": "packages/ui は Backlog のドメインを知らない。props は表示語彙だけ（§5.2）。",
                  "wxt/browser": "packages/ui はブラウザ拡張 API を知らない。Storybook 単体で動く状態を保つ。"
                }
              }
            }
          }
        }
      }
    }
  ]
}
