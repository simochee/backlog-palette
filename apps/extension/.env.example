# wxt dev で Chrome を開いたときに最初に開く URL。
# パレットは Backlog のスペース上でしか動かない（content script の対象外では
# 何も起きない）ので、自分のスペースを入れておくと起動して即 Cmd+K を試せる。
# 例: BP_DEV_START_URL=https://your-space.backlog.jp/dashboard
BP_DEV_START_URL=

# 拡張を読み込めるブラウザのパス。既定はシステムの Chrome。
# web-ext が --load-extension にフォールバックする環境では、branded な
# Chrome 137+ だと拡張が入らない。そのときだけ Chrome for Testing を指定する
# （pnpm exec playwright install chromium で入る）。
BP_DEV_CHROME_BINARY=

# Backlog の OAuth アプリ。ビルド時に埋め込まれる（storage ではなく env に置くのは、
# E2E の storage.local.clear() で設定が消えるのを避けるため）。
# 未設定なら OAuth の導線を出さず、API キー接続だけになる。
WXT_OAUTH_CLIENT_ID=
WXT_OAUTH_CLIENT_SECRET=
