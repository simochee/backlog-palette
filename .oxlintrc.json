{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    // tsconfig の `jsx: react-jsx` では JSX が自動ランタイムに変換されるため、
    // React をスコープに入れる必要がない。
    "react/react-in-jsx-scope": "off",

    // Vite は public/ のファイルを絶対パスで参照する (`import wxtLogo from '/wxt.svg'`)。
    "import/no-absolute-path": "off",

    // default export と同名の named export を持つパッケージすべてに反応する。
    // @storybook/addon-vitest/vitest-plugin のように公式が default import を案内している
    // ケースまで叩くため、シグナルより誤検出が多い。
    "import/no-named-as-default": "off",

    // CSS は値を持たない副作用 import が正しい書き方。JS モジュールの取りこぼしは検出したいので
    // ルールごと切らず、拡張子で絞る。
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],

    // 既定値では `onClick={() => setCount(c => c + 1)}` まで禁止される。
    // React の標準的な書き方なので、アロー省略記法だけ対象から外す。
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],

    // React の props 型に Readonly<> を付ける慣習はなく、@types/react 由来の型も
    // readonly ではない。全 props が違反になり、シグナルが埋もれる。
    "typescript/prefer-readonly-parameter-types": "off",

    // organisms の合成部品 (Palette / SidePanel) は 6〜7 個の部品と辞書・型を束ねるのが
    // 役割で、既定の 10 では合成そのものが違反になる。
    "import/max-dependencies": ["error", { "max": 15 }],

    // 候補リストは role="listbox" / role="option" を div に付けて自前で描く (D-13)。
    // 仮想フォーカス (aria-activedescendant) と行の中の複数要素 (バッジ・キー記号) は
    // <select> / <option> では表現できない。トーストの role="status" は <output> で書く。
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        // Playwright のフィクスチャは第 2 引数の `use` でテストに値を渡す。名前が
        // React Hook の規約と重なるだけで、React とは無関係。
        "react-hooks/rules-of-hooks": "off",

        // 依存を持たない worker フィクスチャは第 1 引数を `{}` で受けるのが
        // Playwright の書き方。分割代入の空パターン以外に宣言する手段が無い。
        "eslint/no-empty-pattern": "off",

        // describe のコールバックは同じ場面のテストを並べる箱で、行数は
        // テストの数に比例する。分割しても構造は増えない。
        "eslint/max-lines-per-function": "off",

        // E2E はプロセスの境界をまたぐ。Service Worker で評価した値や、ビルド成果物の
        // JSON は型で証明できず、テストが期待する形を宣言する以外に読む手段が無い。
        "typescript/no-unsafe-type-assertion": "off",

        // ブラウザの状態を待つポーリングは逐次でなければ意味が無い。
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.stories.tsx", "**/*.invariants.ts"],
      "rules": {
        // storybook の `fn()` はスパイの呼び出し記録を返す。戻り値を無視する void 型の
        // props に渡すのが addon-vitest の想定する使い方で、誤用ではない。
        "typescript/strict-void-return": "off",

        // play function はキー操作を利用者と同じ順序で送る。行を ↓ で辿りながら
        // Enter を検査するようなループは逐次でなければ意味がなく、Promise.all に
        // 置き換えると操作の順序が消える。
        "eslint/no-await-in-loop": "off"
      }
    }
  ]
}
